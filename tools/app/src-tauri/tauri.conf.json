{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "XS40 键位映射编辑器",
  "version": "1.0.0",
  "identifier": "com.xs40.keymap-tool",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "XS40 键位映射编辑器",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}