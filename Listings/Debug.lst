 141          /*******************************************************************************
 142          * Function Name  : mInitSTDIO()
 143          * Description    : CH554串口0初始化,默认使用T1作UART0的波特率发生器,也可以使用T2
 144                             作为波特率发生器
 145          * Input          : None
 146          * Output         : None
 147          * Return         : None
 148          *******************************************************************************/
 149          void mInitSTDIO()
 150          {
 151   1          UINT32 x;
 152   1          UINT8 x2;
 153   1      
 154   1          SM0 = 0;
 155   1          SM1 = 1;
 156   1          SM2 = 0;  //串口0使用模式1
 157   1                    //使用Timer1作为波特率发生器
 158   1          RCLK = 0; //UART0接收时钟
 159   1          TCLK = 0; //UART0发送时钟
 160   1          PCON |= SMOD;
 161   1          x = 10 * FREQ_SYS / UART0_BUAD / 16; //如果更改主频，注意x的值不要溢出
 162   1          x2 = x % 10;
 163   1          x /= 10;
 164   1          if (x2 >= 5)
 165   1              x++; //四舍五入
 166   1      
 167   1          TMOD = TMOD & ~bT1_GATE & ~bT1_CT & ~MASK_T1_MOD | bT1_M1; //0X20，Timer1作为8位自动重载定时
             -器
 168   1          T2MOD = T2MOD | bTMR_CLK | bT1_CLK;                        //Timer1时钟选择
 169   1          TH1 = 0 - x;                                               //12MHz晶振,buad/12为实际需设置波�
             -��率
 170   1          TR1 = 1;                                                   //启动定时器1
 171   1          TI = 1;
 172   1          REN = 1; //串口0接收使能
 173   1      }
