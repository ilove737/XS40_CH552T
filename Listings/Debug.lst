  59          /*******************************************************************************
  60          * Function Name  : mDelayus(UNIT16 n)
  61          * Description    : us延时函数
  62          * Input          : UNIT16 n
  63          * Output         : None
  64          * Return         : None
  65          *******************************************************************************/
  66          void mDelayuS(UINT16 n) // 以uS为单位延时
  67          {
  68   1      #ifdef FREQ_SYS
  69   1      #if FREQ_SYS <= 6000000
                  n >>= 2;
              #endif
  72   1      #if FREQ_SYS <= 3000000
                  n >>= 2;
              #endif
  75   1      #if FREQ_SYS <= 750000
                  n >>= 4;
              #endif
  78   1      #endif
  79   1          while (n)
  80   1          {               // total = 12~13 Fsys cycles, 1uS @Fsys=12MHz
  81   2              ++SAFE_MOD; // 2 Fsys cycles, for higher Fsys, add operation here
  82   2      #ifdef FREQ_SYS
  83   2      #if FREQ_SYS >= 14000000
                      ++SAFE_MOD;
              #endif
  86   2      #if FREQ_SYS >= 16000000
                      ++SAFE_MOD;
              #endif
  89   2      #if FREQ_SYS >= 18000000
                      ++SAFE_MOD;
              #endif
  92   2      #if FREQ_SYS >= 20000000
                      ++SAFE_MOD;
              #endif
  95   2      #if FREQ_SYS >= 22000000
                      ++SAFE_MOD;
              #endif
  98   2      #if FREQ_SYS >= 24000000
                      ++SAFE_MOD;
              #endif
 101   2      #endif
 102   2              --n;
 103   2          }
 104   1      }
