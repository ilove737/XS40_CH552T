  19          /*******************************************************************************
  20          * Function Name  : mTimer_x_ModInit(UINT8 x ,UINT8 mode)
  21          * Description    : CH554定时计数器x模式设置
  22          * Input          : UINT8 mode,Timer模式选择
  23                             0：模式0，13位定时器，TLn的高3位无效
  24                             1：模式1，16位定时器
  25                             2：模式2，8位自动重装定时器
  26                             3：模式3，两个8位定时器  Timer0
  27                             3：模式3，Timer1停止                                                                    
  28          * Output         : None
  29          * Return         : 成功  SUCCESS
  30                             失败  FAIL
  31          *******************************************************************************/
  32          UINT8 mTimer_x_ModInit(UINT8 x ,UINT8 mode)
  33          {
  34   1          if(x == 0){TMOD = TMOD & 0xf0 | mode;}
  35   1          else if(x == 1){TMOD = TMOD & 0x0f | (mode<<4);}
  36   1          else if(x == 2){RCLK = 0;TCLK = 0;CP_RL2 = 0;}                               //16位自动重载定时
             -器
  37   1          else return FAIL;
  38   1          return SUCCESS;
  39   1      }
