  18          /*******************************************************************************
  19          * Function Name  : mTimer_x_ModInit(UINT8 x ,UINT8 mode)
  20          * Description    : CH554定时计数器x模式设置
  21          * Input          : UINT8 mode,Timer模式选择
  22                             0：模式0，13位定时器，TLn的高3位无效
  23                             1：模式1，16位定时器
  24                             2：模式2，8位自动重装定时器
  25                             3：模式3，两个8位定时器  Timer0
  26                             3：模式3，Timer1停止                                                                    
  27          * Output         : None
  28          * Return         : 成功  SUCCESS
  29                             失败  FAIL
  30          *******************************************************************************/
  31          UINT8 mTimer_x_ModInit(UINT8 x ,UINT8 mode)
  32          {
  33   1          if(x == 0){TMOD = TMOD & 0xf0 | mode;}
  34   1          else if(x == 1){TMOD = TMOD & 0x0f | (mode<<4);}
  35   1          else if(x == 2){RCLK = 0;TCLK = 0;CP_RL2 = 0;}                               //16位自动重载定时
             -器
  36   1          else return FAIL;
  37   1          return SUCCESS;
  38   1      }
