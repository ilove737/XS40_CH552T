  71          /*******************************************************************************
  72          * Function Name  : USBDeviceInit()
  73          * Description    : USB设备模式配置,设备模式启动，收发端点配置，中断开启
  74          * Input          : None
  75          * Output         : None
  76          * Return         : None
  77          *******************************************************************************/
  78          void USBDeviceInit()
  79          {
  80   1          IE_USB = 0;
  81   1          USB_CTRL = 0x00;        // 先设定USB设备模式
  82   1          UDEV_CTRL = bUD_PD_DIS; // 禁止DP/DM下拉电阻
  83   1      #ifndef Fullspeed
  84   1          UDEV_CTRL |= bUD_LOW_SPEED; //选择低速1.5M模式
  85   1          USB_CTRL |= bUC_LOW_SPEED;
  86   1      #else
                  UDEV_CTRL &= ~bUD_LOW_SPEED; //选择全速12M模式，默认方式
                  USB_CTRL &= ~bUC_LOW_SPEED;
              #endif
  90   1      
  91   1          UEP2_DMA = Ep2Buffer;                                   //端点2数据传输地址
  92   1          UEP2_3_MOD = UEP2_3_MOD & ~bUEP2_BUF_MOD | bUEP2_TX_EN; //端点2发送使能 64字节缓冲区
  93   1          UEP2_CTRL = bUEP_AUTO_TOG | UEP_T_RES_NAK;              //端点2自动翻转同步标志位，IN事�
             -�返回NAK
  94   1          UEP0_DMA = Ep0Buffer;                                   //端点0数据传输地址
  95   1          UEP4_1_MOD &= ~(bUEP4_RX_EN | bUEP4_TX_EN);             //端点0单64字节收发缓冲区
  96   1          UEP0_CTRL = UEP_R_RES_ACK | UEP_T_RES_NAK;              //OUT事务返回ACK，IN事务返回NAK
  97   1          UEP1_DMA = Ep1Buffer;                                   //端点1数据传输地址
  98   1          UEP4_1_MOD = UEP4_1_MOD & ~bUEP1_BUF_MOD | bUEP1_TX_EN; //端点1发送使能 64字节缓冲区
  99   1          UEP1_CTRL = bUEP_AUTO_TOG | UEP_T_RES_NAK;              //端点1自动翻转同步标志位，IN事�
             -�返回NAK
 100   1      
 101   1          USB_DEV_AD = 0x00;
 102   1          USB_CTRL |= bUC_DEV_PU_EN | bUC_INT_BUSY | bUC_DMA_EN; // 启动USB设备及DMA，在中断期间中�
             -�标志未清除前自动返回NAK
 103   1          UDEV_CTRL |= bUD_PORT_EN;                              // 允许USB端口
 104   1          USB_INT_FG = 0xFF;                                     // 清中断标志
 105   1          USB_INT_EN = bUIE_SUSPEND | bUIE_TRANSFER | bUIE_BUS_RST;
 106   1          IE_USB = 1;
 107   1      }
