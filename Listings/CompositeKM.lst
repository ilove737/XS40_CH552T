  84          * Function Name  : USBDeviceInit()
  85          * Description    : USB设备模式配置,设备模式启动，收发端点配置，中断开启
  86          * Input          : None
  87          * Output         : None
  88          * Return         : None
  89          *******************************************************************************/
  90          void USBDeviceInit()
  91          {
  92   1          IE_USB = 0;
  93   1          USB_CTRL = 0x00;        // 先设定USB设备模式
  94   1          UDEV_CTRL = bUD_PD_DIS; // 禁止DP/DM下拉电阻
  95   1      #ifndef Fullspeed
  96   1          UDEV_CTRL |= bUD_LOW_SPEED; //选择低速1.5M模式
  97   1          USB_CTRL |= bUC_LOW_SPEED;
  98   1      #else
                  UDEV_CTRL &= ~bUD_LOW_SPEED; //选择全速12M模式，默认方式
                  USB_CTRL &= ~bUC_LOW_SPEED;
              #endif
 102   1      
 103   1          UEP2_DMA = Ep2Buffer;                                   //端点2数据传输地址
 104   1          UEP2_3_MOD = UEP2_3_MOD & ~bUEP2_BUF_MOD | bUEP2_TX_EN; //端点2发送使能 64字节缓冲区
 105   1          UEP2_CTRL = bUEP_AUTO_TOG | UEP_T_RES_NAK;              //端点2自动翻转同步标志位，IN事�
             -�返回NAK
 106   1          UEP0_DMA = Ep0Buffer;                                   //端点0数据传输地址
 107   1          UEP4_1_MOD &= ~(bUEP4_RX_EN | bUEP4_TX_EN);             //端点0单64字节收发缓冲区
 108   1          UEP0_CTRL = UEP_R_RES_ACK | UEP_T_RES_NAK;              //OUT事务返回ACK，IN事务返回NAK
 109   1          UEP1_DMA = Ep1Buffer;                                   //端点1数据传输地址
 110   1          UEP4_1_MOD = UEP4_1_MOD & ~bUEP1_BUF_MOD | bUEP1_TX_EN; //端点1发送使能 64字节缓冲区
 111   1          UEP1_CTRL = bUEP_AUTO_TOG | UEP_T_RES_NAK;              //端点1自动翻转同步标志位，IN事�
             -�返回NAK
