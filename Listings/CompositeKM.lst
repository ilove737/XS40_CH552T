  68          /*******************************************************************************
  69          * Function Name  : USBDeviceInit()
  70          * Description    : USB设备模式配置,设备模式启动，收发端点配置，中断开启
  71          * Input          : None
  72          * Output         : None
  73          * Return         : None
  74          *******************************************************************************/
  75          void USBDeviceInit()
  76          {
  77   1          IE_USB = 0;
  78   1          USB_CTRL = 0x00;        // 先设定USB设备模式
  79   1          UDEV_CTRL = bUD_PD_DIS; // 禁止DP/DM下拉电阻
  80   1      #ifndef Fullspeed
  81   1          UDEV_CTRL |= bUD_LOW_SPEED; //选择低速1.5M模式
  82   1          USB_CTRL |= bUC_LOW_SPEED;
  83   1      #else
                  UDEV_CTRL &= ~bUD_LOW_SPEED; //选择全速12M模式，默认方式
                  USB_CTRL &= ~bUC_LOW_SPEED;
              #endif
  87   1      
  88   1          UEP2_DMA = Ep2Buffer;                                   //端点2数据传输地址
  89   1          UEP2_3_MOD = UEP2_3_MOD & ~bUEP2_BUF_MOD | bUEP2_TX_EN; //端点2发送使能 64字节缓冲区
  90   1          UEP2_CTRL = bUEP_AUTO_TOG | UEP_T_RES_NAK;              //端点2自动翻转同步标志位，IN事�
             -�返回NAK
  91   1          UEP0_DMA = Ep0Buffer;                                   //端点0数据传输地址
  92   1          UEP4_1_MOD &= ~(bUEP4_RX_EN | bUEP4_TX_EN);             //端点0单64字节收发缓冲区
  93   1          UEP0_CTRL = UEP_R_RES_ACK | UEP_T_RES_NAK;              //OUT事务返回ACK，IN事务返回NAK
  94   1          UEP1_DMA = Ep1Buffer;                                   //端点1数据传输地址
  95   1          UEP4_1_MOD = UEP4_1_MOD & ~bUEP1_BUF_MOD | bUEP1_TX_EN; //端点1发送使能 64字节缓冲区
  96   1          UEP1_CTRL = bUEP_AUTO_TOG | UEP_T_RES_NAK;              //端点1自动翻转同步标志位，IN事�
             -�返回NAK
  97   1      
  98   1          USB_DEV_AD = 0x00;
  99   1          USB_CTRL |= bUC_DEV_PU_EN | bUC_INT_BUSY | bUC_DMA_EN; // 启动USB设备及DMA，在中断期间中�
             -�标志未清除前自动返回NAK
 100   1          UDEV_CTRL |= bUD_PORT_EN;                              // 允许USB端口
 101   1          USB_INT_FG = 0xFF;                                     // 清中断标志
 102   1          USB_INT_EN = bUIE_SUSPEND | bUIE_TRANSFER | bUIE_BUS_RST;
 103   1          IE_USB = 1;
 104   1      }
