  16          /*******************************************************************************
  17          * Function Name  : Port1Cfg()
  18          * Description    : 端口1配置
  19          * Input          : Mode  0 = 浮空输入，无上拉
  20                                   1 = 推挽输入输出
  21                                   2 = 开漏输入输出，无上拉
  22                                   3 = 类51模式，开漏输入输出，有上拉，内部电路可以加速由低
             -到高的电平爬升         
  23                             ,UINT8 Pin   (0-7)                                                                                    
  24          * Output         : None
  25          * Return         : None
  26          *******************************************************************************/
  27          void Port1Cfg(UINT8 Mode,UINT8 Pin)
  28          {
  29   1        switch(Mode){
  30   2          case 0:
  31   2            P1_MOD_OC = P1_MOD_OC & ~(1<<Pin);
  32   2            P1_DIR_PU = P1_DIR_PU &   ~(1<<Pin);      
  33   2            break;
  34   2          case 1:
  35   2            P1_MOD_OC = P1_MOD_OC & ~(1<<Pin);
  36   2            P1_DIR_PU = P1_DIR_PU |   (1<<Pin);                               
  37   2            break;            
  38   2          case 2:
  39   2            P1_MOD_OC = P1_MOD_OC | (1<<Pin);
  40   2            P1_DIR_PU = P1_DIR_PU &   ~(1<<Pin);                              
  41   2            break;            
  42   2          case 3:
  43   2            P1_MOD_OC = P1_MOD_OC | (1<<Pin);
  44   2            P1_DIR_PU = P1_DIR_PU |   (1<<Pin);                       
  45   2            break;
  46   2          default:
  47   2            break;                    
  48   2        }
  49   1      }
